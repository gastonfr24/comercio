```typescript
// Validar que el usuario esté autenticado antes de proceder
if (!session) {
  redirect('/login')
}

// Calcular el precio total incluyendo impuestos
const taxRate = getTaxRate(user.region)
const totalWithTax = subtotal * (1 + taxRate)

// Filtrar productos por categoría y disponibilidad
const availableProducts = products.filter(
  (p) => p.category === selectedCategory && p.inStock
)
```

