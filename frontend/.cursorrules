# Frontend - Next.js + TypeScript Rules

## 📋 REGLAS ESTRICTAS DE CÓDIGO

### Idioma y Nomenclatura

1. **Nombres de componentes**: INGLÉS (PascalCase)
2. **Nombres de funciones**: INGLÉS (camelCase)
3. **Nombres de variables**: INGLÉS (camelCase)
4. **Comentarios**: ESPAÑOL (solo cuando sea necesario)
5. **JSDoc**: INGLÉS (para componentes complejos)

### Documentación de Componentes (OBLIGATORIO para complejos)

#### Formato JSDoc

```typescript
/**
 * ProductCard component displays product information with actions.
 * 
 * This component handles product display, add to cart functionality,
 * and favorite/wishlist actions. It supports different display modes
 * (grid/list) and loading states.
 * 
 * @component
 * @example
 * ```tsx
 * <ProductCard 
 *   product={product}
 *   onAddToCart={handleAddToCart}
 *   displayMode="grid"
 * />
 * ```
 */
export function ProductCard({ product, onAddToCart, displayMode }: ProductCardProps) {
  // Implementation
}
```

#### Interfaces y Types (OBLIGATORIO)

```typescript
/**
 * Props for the ProductCard component.
 */
interface ProductCardProps {
  /** Product data to display */
  product: Product
  /** Callback fired when user clicks add to cart */
  onAddToCart: (productId: string) => void
  /** Display mode for the card */
  displayMode?: 'grid' | 'list'
  /** Whether the card should show loading state */
  isLoading?: boolean
}

/**
 * Product data structure from the API.
 */
interface Product {
  /** Unique product identifier */
  id: string
  /** Product name */
  name: string
  /** Product description in markdown format */
  description: string
  /** Price in USD */
  price: number
  /** Product category */
  category: Category
  /** Product images URLs */
  images: string[]
  /** Whether the product is in stock */
  inStock: boolean
}
```

#### Funciones Utilitarias

```typescript
/**
 * Format a price value to USD currency string.
 * 
 * @param price - The price value to format
 * @param includeSymbol - Whether to include the $ symbol
 * @returns Formatted price string
 * 
 * @example
 * ```ts
 * formatPrice(29.99) // "$29.99"
 * formatPrice(29.99, false) // "29.99"
 * ```
 */
export function formatPrice(price: number, includeSymbol: boolean = true): string {
  const formatted = price.toFixed(2)
  return includeSymbol ? `$${formatted}` : formatted
}
```

#### Hooks Personalizados

```typescript
/**
 * Custom hook for managing shopping cart state.
 * 
 * This hook provides cart operations including add, remove, update quantity,
 * and clear. It persists cart data to localStorage and calculates totals
 * automatically.
 * 
 * @returns Cart state and operations
 * 
 * @example
 * ```tsx
 * const { items, total, addItem, removeItem } = useCart()
 * ```
 */
export function useCart() {
  const [items, setItems] = useState<CartItem[]>([])
  
  /**
   * Add an item to the cart or increment quantity if exists.
   * 
   * @param productId - The product ID to add
   * @param quantity - Quantity to add (default: 1)
   */
  const addItem = useCallback((productId: string, quantity: number = 1) => {
    // Implementation
  }, [])
  
  return { items, total, addItem, removeItem }
}
```

### Componentes React

#### Estructura de Componente

```typescript
'use client'

import { useState, useCallback, useEffect } from 'react'
import { Card, CardHeader, CardTitle, CardContent } from '@/components/ui/card'
import { Button } from '@/components/ui/button'
import { formatPrice } from '@/lib/utils'
import type { Product } from '@/types'

interface ProductCardProps {
  product: Product
  onAddToCart: (productId: string) => void
}

/**
 * ProductCard displays a single product with add to cart action.
 */
export function ProductCard({ product, onAddToCart }: ProductCardProps) {
  const [isLoading, setIsLoading] = useState(false)
  
  /**
   * Handle add to cart button click.
   * Shows loading state and calls the callback.
   */
  const handleAddToCart = useCallback(async () => {
    setIsLoading(true)
    try {
      await onAddToCart(product.id)
    } finally {
      setIsLoading(false)
    }
  }, [product.id, onAddToCart])
  
  return (
    <Card>
      <CardHeader>
        <CardTitle>{product.name}</CardTitle>
      </CardHeader>
      <CardContent>
        <p className="text-2xl font-bold">
          {formatPrice(product.price)}
        </p>
        <Button 
          onClick={handleAddToCart}
          disabled={isLoading || !product.inStock}
        >
          {isLoading ? 'Adding...' : 'Add to Cart'}
        </Button>
      </CardContent>
    </Card>
  )
}
```

### Server Components y Client Components

```typescript
// ✅ CORRECTO - Server Component (por defecto)
import { getProducts } from '@/lib/api'

interface ProductsPageProps {
  searchParams: { category?: string }
}

/**
 * Products page displaying product catalog with filtering.
 * Server component that fetches data at request time.
 */
export default async function ProductsPage({ searchParams }: ProductsPageProps) {
  const products = await getProducts({ category: searchParams.category })
  
  return (
    <div>
      <h1>Products</h1>
      <ProductGrid products={products} />
    </div>
  )
}

// ✅ CORRECTO - Client Component (cuando se necesita interactividad)
'use client'

import { useState } from 'react'

/**
 * ProductGrid displays products in a responsive grid with sorting.
 * Client component for interactive sorting functionality.
 */
export function ProductGrid({ products }: ProductGridProps) {
  const [sortBy, setSortBy] = useState<'price' | 'name'>('name')
  
  // Implementation
}
```

### API Client y Data Fetching

```typescript
/**
 * API client for product-related endpoints.
 * Handles all HTTP requests to the products API.
 */

import axios from 'axios'
import type { Product, ProductFilters } from '@/types'

const API_URL = process.env.API_URL || 'http://localhost:8000/api'

/**
 * Fetch all products with optional filtering.
 * 
 * @param filters - Optional filters for products
 * @returns Promise resolving to array of products
 * @throws {APIError} If the request fails
 * 
 * @example
 * ```ts
 * const products = await getProducts({ category: 'electronics' })
 * ```
 */
export async function getProducts(
  filters?: ProductFilters
): Promise<Product[]> {
  try {
    const response = await axios.get(`${API_URL}/products/`, {
      params: filters,
    })
    return response.data
  } catch (error) {
    console.error('Failed to fetch products:', error)
    throw new APIError('Failed to fetch products')
  }
}

/**
 * Fetch a single product by ID.
 * 
 * @param id - Product ID
 * @returns Promise resolving to product data
 * @throws {APIError} If product not found or request fails
 */
export async function getProductById(id: string): Promise<Product> {
  const response = await axios.get(`${API_URL}/products/${id}/`)
  return response.data
}
```

