# Django Settings
SECRET_KEY=django-insecure-CHANGE-THIS-IN-PRODUCTION-with-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# For SQLite (Development - Default)
DATABASE_URL=sqlite:///db.sqlite3

# For PostgreSQL (Production)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# CORS Settings (if needed)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Superuser Configuration (for development only)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@comercio.local
DJANGO_SUPERUSER_PASSWORD=change_this_password
