### Estructura de Archivos

#### models.py

```python
"""
Models for the products application.

This module contains all database models related to products,
categories, and inventory management.
"""
from django.db import models
from django.contrib.auth.models import User
from typing import Optional
from decimal import Decimal


class Category(models.Model):
    """Product category for organizing the catalog."""
    
    name = models.CharField(max_length=100)
    slug = models.SlugField(unique=True)
    description = models.TextField(blank=True)
    
    class Meta:
        verbose_name_plural = "categories"
        ordering = ['name']
    
    def __str__(self) -> str:
        return self.name
    
    def get_product_count(self) -> int:
        """
        Get the number of active products in this category.
        
        Returns:
            Number of active products
        """
        return self.products.filter(is_active=True).count()
```

#### views.py

```python
"""
API views for product management.

This module provides REST API endpoints for CRUD operations
on products, including filtering, searching, and pagination.
"""
from rest_framework import viewsets, status
from rest_framework.decorators import action
from rest_framework.response import Response
from typing import Any


class ProductViewSet(viewsets.ModelViewSet):
    """
    ViewSet for managing products.
    
    Provides standard CRUD operations plus custom actions
    for searching and filtering products by various criteria.
    """
    
    queryset = Product.objects.all()
    serializer_class = ProductSerializer
    
    @action(detail=False, methods=['get'])
    def search(self, request: Any) -> Response:
        """
        Search products by name or description.
        
        Query parameters:
            q: Search query string
            
        Returns:
            List of matching products
        """
        query = request.query_params.get('q', '')
        products = self.get_queryset().filter(
            models.Q(name__icontains=query) |
            models.Q(description__icontains=query)
        )
        serializer = self.get_serializer(products, many=True)
        return Response(serializer.data)
```

#### serializers.py

```python
"""
Serializers for product-related models.

This module contains all DRF serializers for products,
categories, and related data transformations.
"""
from rest_framework import serializers
from typing import Dict, Any


class ProductSerializer(serializers.ModelSerializer):
    """
    Serializer for Product model with nested category data.
    
    Includes validation for price ranges and automatic
    slug generation from product name.
    """
    
    category_name = serializers.CharField(
        source='category.name',
        read_only=True
    )
    
    class Meta:
        model = Product
        fields = [
            'id', 'name', 'slug', 'description',
            'price', 'category', 'category_name',
            'is_active', 'created_at'
        ]
        read_only_fields = ['id', 'slug', 'created_at']
    
    def validate_price(self, value: Decimal) -> Decimal:
        """
        Validate that price is positive and within acceptable range.
        
        Args:
            value: Price to validate
            
        Returns:
            Validated price
            
        Raises:
            ValidationError: If price is invalid
        """
        if value <= 0:
            raise serializers.ValidationError(
                "Price must be greater than zero"
            )
        if value > 999999:
            raise serializers.ValidationError(
                "Price exceeds maximum allowed value"
            )
        return value
```

### Tests (OBLIGATORIO)

```python
"""
Tests for product API endpoints.

This module contains unit and integration tests for all
product-related API operations.
"""
from django.test import TestCase
from rest_framework.test import APIClient
from decimal import Decimal


class ProductAPITestCase(TestCase):
    """Test cases for Product API endpoints."""
    
    def setUp(self) -> None:
        """Set up test data and client."""
        self.client = APIClient()
        self.category = Category.objects.create(
            name="Electronics",
            slug="electronics"
        )
    
    def test_create_product_success(self) -> None:
        """
        Test successful product creation with valid data.
        
        Verifies that:
        - Product is created with correct data
        - Response status is 201 Created
        - Slug is auto-generated correctly
        """
        data = {
            'name': 'Laptop',
            'price': '999.99',
            'category': self.category.id
        }
        response = self.client.post('/api/products/', data)
        
        self.assertEqual(response.status_code, 201)
        self.assertEqual(response.data['name'], 'Laptop')
        self.assertEqual(response.data['slug'], 'laptop')
```

